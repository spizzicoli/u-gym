-- ============================================
-- U-GYM — Script SQL per Supabase
-- Vai su Supabase → SQL Editor → incolla tutto
-- ============================================

-- Tabella Palestre
create table if not exists gyms (
  id bigint primary key generated always as identity,
  name text not null,
  address text not null,
  distance text,
  open boolean default true,
  hours text default '06:00 – 22:00',
  members integer default 0,
  created_at timestamptz default now()
);

-- Tabella Giorni della Scheda
create table if not exists scheda_days (
  id bigint primary key generated always as identity,
  day text not null,
  sort_order integer default 0
);

-- Tabella Esercizi
create table if not exists exercises (
  id bigint primary key generated always as identity,
  scheda_day_id bigint references scheda_days(id) on delete cascade,
  name text not null,
  sets text not null,
  weight text,
  muscle text,
  gif_url text,
  sort_order integer default 0
);

-- Tabella Corsi
create table if not exists corsi (
  id bigint primary key generated always as identity,
  name text not null,
  coach text not null,
  schedule text not null,
  duration text not null,
  spots integer default 0,
  max_spots integer default 10,
  price numeric(10,2) not null,
  tag text,
  tag_color text default '#3ddc84',
  description text,
  enrolled boolean default false,
  created_at timestamptz default now()
);

-- Tabella Affluenza (dati per il grafico home)
create table if not exists occupancy (
  id bigint primary key generated always as identity,
  gym_id bigint references gyms(id) on delete cascade,
  hour integer not null check (hour >= 0 and hour <= 23),
  percentage integer not null check (percentage >= 0 and percentage <= 100)
);

